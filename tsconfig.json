{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@barberlab/core": ["packages/core/src"],
      "@barberlab/api-secure": ["packages/api-secure/src"],
      "@barberlab/api-vulnerable": ["packages/api-vulnerable/src"]
    }
  },
  "exclude": ["node_modules", "dist", "packages/*/dist", "packages/*/node_modules"]
}
